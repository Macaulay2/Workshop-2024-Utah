    R = numberField (QQ[a]/ideal(a^2+1))
    S = simpleExtension (R) 
    assert(isSurjective  matrixFromNumberFieldMap S#1)
    assert(isInjective  matrixFromNumberFieldMap S#1)
///
TEST /// --Test #8
    R = numberField (QQ[a]/ideal(a^2+1))
    S = simpleExtension (R, usePari=>false) 
    assert(isSurjective  matrixFromNumberFieldMap S#1)
    assert(isInjective  matrixFromNumberFieldMap S#1)
