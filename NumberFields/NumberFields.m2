-- Investigate - Toshi
isLinear = method(Options=>{})
isLinear(Ideal) := opts -> (J1) -> (
    if J1 == 0 then return true;
    idealGens := (entries gens J1)#0;
    length(idealGens)<=1 and max(degree(idealGens#0))<=1
)

